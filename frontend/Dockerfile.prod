# Production frontend image -- multi-stage: build the static Vite bundle,
# then serve it from a plain nginx, not the Vite dev server the dev
# `Dockerfile` runs. This container never talks to the internet directly;
# the edge nginx (deploy/nginx/app.conf) proxies to it internally.
FROM node:20-alpine AS build

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci

COPY . .

# Vite inlines VITE_* vars into the built JS at build time, not runtime --
# a relative path (not an absolute origin) so the same build works whether
# it's reached as icelevel.ru or www.icelevel.ru, and needs no CORS at all
# since every request stays same-origin through the edge nginx's /api/
# proxy (see deploy/nginx/app.conf).
ARG VITE_API_BASE_URL=/api
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
RUN npm run build

FROM nginx:1.27-alpine AS runtime
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx-spa.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
