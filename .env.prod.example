# Production env template for icelevel.ru. Copy to `.env` ON THE SERVER
# (never commit the real file -- it's gitignored, `git pull` never touches
# it, so code and secrets update through two entirely separate channels)
# and fill in every __CHANGE_ME__. See docs/deploy.md for exactly how to
# generate each value and the full deploy runbook.
#
#   cp .env.prod.example .env && chmod 600 .env

APP_NAME=IceLevel
ENVIRONMENT=production

# -- Postgres --
# docker-compose.prod.yml builds DATABASE_URL from these three at compose
# parse time (postgres/backend service definitions) -- these are the
# actual source of truth in prod, not a full DATABASE_URL line here.
POSTGRES_USER=icelevel
POSTGRES_PASSWORD=__CHANGE_ME__
POSTGRES_DB=icelevel

# -- RabbitMQ --
# Same story as Postgres above -- docker-compose.prod.yml builds
# RABBITMQ_URL from these two.
RABBITMQ_USER=icelevel
RABBITMQ_PASSWORD=__CHANGE_ME__

# -- JWT --
JWT_SECRET_KEY=__CHANGE_ME__
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# -- CORS --
# Same-origin in production (edge nginx proxies /api/* to the backend on
# the same domain, see deploy/nginx/app.conf) -- CORS shouldn't matter for
# the web app itself, but kept locked to the real origins as defense in
# depth rather than left at the dev default (localhost:5173).
CORS_ORIGINS=["https://icelevel.ru","https://www.icelevel.ru"]
# Empty disables the dev-only private-LAN allowance entirely (see
# app/core/config.py's cors_origin_regex default) -- there's no LAN dev
# client hitting a production server.
CORS_ORIGIN_REGEX=

# -- Web Push (VAPID) --
# MUST be regenerated for prod -- the default keypair in app/core/config.py
# is committed (intentionally not secret) dev-only material.
VAPID_PRIVATE_KEY=__CHANGE_ME__
VAPID_PUBLIC_KEY=__CHANGE_ME__
VAPID_SUBJECT=mailto:lexa95k@gmail.com

# -- AI coach chat (optional) --
# z.ai's own OpenAI-compatible endpoint (not OpenRouter -- OpenRouter's
# Cloudflare edge blocks every request from this server's IP/ASN, see
# coach_chat_service.py's own docstring). Leave blank to keep the feature
# off (503) rather than pay per message before it's needed.
ZAI_API_KEY=
# Which model the coach-chat call uses -- a config value, not a code
# constant, so switching models needs no deploy. Default set in
# app/core/config.py's coach_chat_model (glm-4.7-flash, z.ai's free tier);
# override here once real usage justifies a paid model, e.g.:
# COACH_CHAT_MODEL=glm-5.3

# -- Email (Resend) --
# onboarding@resend.dev (the local-dev default) only delivers to the
# Resend account owner -- real users won't receive anything until
# icelevel.ru is verified in Resend (SPF/DKIM DNS records) and this is
# switched to a noreply@icelevel.ru address on that verified domain.
RESEND_API_KEY=__CHANGE_ME__
FRONTEND_URL=https://icelevel.ru
EMAIL_FROM_ADDRESS="IceLevel <noreply@icelevel.ru>"
