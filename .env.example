APP_NAME=IceLevel
ENVIRONMENT=local

# Postgres (matches docker-compose.yml defaults)
DATABASE_URL=postgresql+asyncpg://hockey:hockey@localhost:5432/hockey_level_up

# RabbitMQ (matches docker-compose.yml defaults; wired up starting Phase 3)
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# JWT
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Web Push (VAPID) -- dev-only key pair, generated once via
# py_vapid.Vapid().generate_keys(); regenerate before any real deployment.
VAPID_PRIVATE_KEY=fmVrz4YsbsIibjJcNvHVpUGLkDuAHvcO-2CQwsveCy0
VAPID_PUBLIC_KEY=BPD8KGVrzMDG5oZONsvz7dVBRDiE9b8IRFJdQn7BZ-Adqjz7o_U753g3zrK01JeBzBmU3NVoUJxNWPVNa1IVOXA
VAPID_SUBJECT=mailto:admin@example.com

# AI coach chat (OpenRouter, OpenAI-совместимый эндпоинт) -- заполнить перед
# включением ИИ-чата. Пока пусто, POST /users/me/coach-chat отвечает 503
# даже премиум-пользователям. Модель настраивается отдельно (COACH_CHAT_MODEL),
# см. coach_chat_service.py.
OPENROUTER_API_KEY=

# Email (Resend) -- verify-email/password-reset. Пока пусто: письмо
# подтверждения при регистрации молча не отправляется, а
# POST /auth/password-reset/request отвечает 503.
RESEND_API_KEY=
FRONTEND_URL=http://localhost:5173
EMAIL_FROM_ADDRESS="IceLevel <onboarding@resend.dev>"
